{
  "name": "slidev-theme-bear",
  "type": "module",
  "version": "0.0.1",
  "description": "«Мишка на сервере» — инженерная тема для Slidev: холодная приглушённая палитра catppuccin, один акцент Sapphire, catppuccin-код, PT Sans + JetBrains Mono, доступность ≥ AA",
  "keywords": [
    "slidev-theme",
    "slidev",
    "catppuccin",
    "bear",
    "sre",
    "engineering"
  ],
  "files": [
    "components",
    "example.md",
    "global-top.vue",
    "layoutHelper.ts",
    "layouts",
    "public",
    "setup",
    "styles",
    "uno.config.ts"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "brand:sync": "node scripts/sync-brand.mjs",
    "build": "slidev build example.md",
    "contrast": "node scripts/check-contrast.mjs",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "prepare": "node scripts/sync-brand.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@iconify-json/carbon": "^1.2.25",
    "@slidev/types": "^52.19.0",
    "tm-themes": "^1.12.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@jtprogru/mishka-ds": "github:jtprogru/mishka-ds",
    "@slidev/cli": "^52.19.0",
    "eslint": "^10.8.0",
    "playwright-chromium": "^1.62.1"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "dompurify": "^3.4.13"
  },
  "//": "Learn more: https://sli.dev/themes/write-a-theme.html",
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki",
    "defaults": {
      "fonts": {
        "sans": "PT Sans",
        "mono": "JetBrains Mono",
        "weights": "400,700",
        "italic": true,
        "provider": "none",
        "local": "PT Sans, JetBrains Mono"
      }
    },
    "themeConfig": {
      "primary": "#209fb5"
    }
  }
}
